<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity3">

    <ImageView
        android:id="@+id/background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_total"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_line_perfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.07" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_line_buscador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.14637482"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView_perfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/boton_madera"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_perfil"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.509"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="51dp"
            android:background="@drawable/boton_madera">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_perfil"
                app:shapeAppearanceOverlay="@style/CircleImageView" />

            <TextView
                android:id="@+id/nombre_usuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_gravity="center"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/cormorant_garamond"
                android:text="@string/welcome_jarl_erik"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAppearance="@style/TextShadowStyle"/>

            <ImageView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="70dp"
                android:src="@drawable/moneda" />

            <TextView
                android:id="@+id/moneda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/cormorant_garamond"
                android:text="@string/_350"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/mas" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/boton3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/micro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_buscador"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_contrasena">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="20dp"
            android:layout_gravity="start|center_vertical"
            android:layout_weight="1"
            android:src="@drawable/lupa"
            app:tint="@color/amarillo_vikingo"/>

        <EditText
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:hint="@string/search"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColorHint="@color/amarillo_vikingo"
            android:fontFamily="@font/cormorant_garamond"
            android:layout_marginStart="10dp"
            android:textAppearance="@style/TextShadowStyle"/>

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:layout_gravity="right"
            android:src="@drawable/boton_escudo"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_line_oferta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.3474692" />

    <ImageView
        android:id="@+id/oferta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_oferta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guide_line_buscador"
        app:srcCompat="@drawable/oferta_vikingos" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_line_recommend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_line_final2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.879617" />

    <ImageView
        android:id="@+id/espadas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/weapons"
        app:layout_constraintEnd_toStartOf="@+id/casco"
        app:layout_constraintHorizontal_bias="0.114"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guide_line_oferta"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/espadas"
        android:scaleType="fitCenter"/>

    <TextView
        android:id="@+id/weapons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/weapons"
        android:textColor="@color/amarillo_vikingo"
        android:fontFamily="@font/cormorant_garamond"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/espadas"
        app:layout_constraintBottom_toTopOf="@id/guide_line_recommend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/armor"
        android:textAppearance="@style/TextShadowStyle"/>

    <ImageView
        android:id="@+id/casco"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/guide_line_oferta"
        app:layout_constraintBottom_toTopOf="@id/armor"
        app:layout_constraintStart_toEndOf="@id/espadas"
        app:layout_constraintEnd_toStartOf="@id/ropaje"
        app:srcCompat="@drawable/casco"
        android:scaleType="fitCenter"/>

    <TextView
        android:id="@+id/armor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/armor"
        android:textColor="@color/amarillo_vikingo"
        android:fontFamily="@font/cormorant_garamond"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/casco"
        app:layout_constraintBottom_toTopOf="@id/guide_line_recommend"
        app:layout_constraintStart_toEndOf="@id/weapons"
        app:layout_constraintEnd_toStartOf="@id/clothing"
        android:textAppearance="@style/TextShadowStyle"/>

    <ImageView
        android:id="@+id/ropaje"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/guide_line_oferta"
        app:layout_constraintBottom_toTopOf="@id/clothing"
        app:layout_constraintStart_toEndOf="@id/casco"
        app:layout_constraintEnd_toStartOf="@id/artilugio"
        app:srcCompat="@drawable/ropaje"
        android:scaleType="fitCenter"/>

    <TextView
        android:id="@+id/clothing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/clothing"
        android:textColor="@color/amarillo_vikingo"
        android:fontFamily="@font/cormorant_garamond"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ropaje"
        app:layout_constraintBottom_toTopOf="@id/guide_line_recommend"
        app:layout_constraintStart_toEndOf="@id/armor"
        app:layout_constraintEnd_toStartOf="@id/artifacts"
        android:textAppearance="@style/TextShadowStyle"/>

    <ImageView
        android:id="@+id/artilugio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/guide_line_oferta"
        app:layout_constraintBottom_toTopOf="@id/artifacts"
        app:layout_constraintStart_toEndOf="@id/ropaje"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/artilugio"
        android:scaleType="fitCenter"/>

    <TextView
        android:id="@+id/artifacts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/artifacts"
        android:textColor="@color/amarillo_vikingo"
        android:fontFamily="@font/cormorant_garamond"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/artilugio"
        app:layout_constraintBottom_toTopOf="@id/guide_line_recommend"
        app:layout_constraintStart_toEndOf="@id/clothing"
        app:layout_constraintEnd_toEndOf="parent"
        android:textAppearance="@style/TextShadowStyle"/>

    <TextView
        android:id="@+id/recommend_for_you"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="start"
        android:text="@string/recommend_for_you"
        android:textColor="@color/amarillo_vikingo"
        android:fontFamily="@font/cormorant_garamond"
        android:textSize="20sp"
        android:layout_marginStart="10dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guide_line_recommend"
        android:textAppearance="@style/TextShadowStyle"/>


    <ImageButton
        android:id="@+id/boton_compra_espadas"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:background="@android:color/transparent"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_final2"
        app:layout_constraintEnd_toStartOf="@+id/boton_compra_armadura"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_for_you"
        app:layout_constraintVertical_bias="0.282"
        app:srcCompat="@drawable/boton_compra_espada" />

    <ImageButton
        android:id="@+id/boton_compra_armadura"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@android:color/transparent"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_final2"
        app:layout_constraintEnd_toStartOf="@+id/boton_compra_artilugios"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/boton_compra_espadas"
        app:layout_constraintTop_toBottomOf="@+id/recommend_for_you"
        app:layout_constraintVertical_bias="0.282"
        app:srcCompat="@drawable/boton_compra_ropa" />

    <ImageButton
        android:id="@+id/boton_compra_artilugios"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        android:background="@android:color/transparent"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_final2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/boton_compra_armadura"
        app:layout_constraintTop_toBottomOf="@+id/recommend_for_you"
        app:layout_constraintVertical_bias="0.282"
        app:srcCompat="@drawable/boton_compra_artilugios" />

    <ImageButton
        android:id="@+id/home"
        android:layout_width="75dp"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/icono_home"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cartera"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_chainStyle="spread_inside" />

    <ImageButton
        android:id="@+id/cartera"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="15dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/inicio"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/home"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintVertical_bias="0.521"
        app:srcCompat="@drawable/icono_cartera" />

    <ImageButton
        android:id="@+id/inicio"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="10dp"
        app:srcCompat="@drawable/icono_inicio"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/cartera"
        app:layout_constraintEnd_toStartOf="@+id/campana1"
        app:layout_constraintHorizontal_weight="1" />

    <ImageButton
        android:id="@+id/campana1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="30dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/icono_campana"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/inicio"
        app:layout_constraintEnd_toStartOf="@id/casco_guerrero"
        app:layout_constraintHorizontal_weight="1" />

    <ImageButton
        android:id="@+id/casco_guerrero"
        android:layout_width="70dp"
        android:layout_height="50dp"
        android:background="@android:color/transparent"
        android:layout_marginBottom="15dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/icono_casco_guerrero"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/campana1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

</androidx.constraintlayout.widget.ConstraintLayout>