<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main14"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity14">

    <ImageView
        android:id="@+id/background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_total"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_line_perfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.08" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/boton_madera"
        app:strokeWidth="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_perfil"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.509"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/boton_madera">

            <ImageView
                android:id="@+id/atras9"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="30dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/outline_arrow_left_alt_24"/>

            <TextView
                android:id="@+id/viking_sword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:textSize="25sp"
                android:text="@string/raid_on_england"
                android:layout_gravity="center"
                android:textColor="@color/amarillo_vikingo"
                android:textStyle="bold"
                android:fontFamily="@font/cormorant_garamond"
                android:textAppearance="@style/TextShadowStyle"/>

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="50dp"
                android:layout_gravity="center"
                android:src="@drawable/maletin"
                android:scaleType="centerCrop"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview_vikingos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line_perfil"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:src="@drawable/raid_inglaterra2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:src="@drawable/linea_amarilla"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardview_vikingos" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/inicio"
        app:layout_constraintEnd_toStartOf="@+id/margen_derecho"
        app:layout_constraintStart_toStartOf="@+id/margen_izquierdo"
        app:layout_constraintTop_toBottomOf="@+id/imageView3">

        <TextView
            android:id="@+id/texto_raid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/cormorant_garamond"
            android:textStyle="bold"
            android:text="@string/join_the_raid_on_english_shores_at_dawn_plunder_nvillages_bring_back_riches_and_earn_glory"
            android:textColor="@color/amarillo_vikingo"
            android:textSize="15sp"
            android:textAppearance="@style/TextShadowStyle"/>

        <ImageView
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:scaleType="centerCrop"
            android:src="@drawable/linea_amarilla"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/cormorant_garamond"
            android:textStyle="bold"
            android:text="@string/leaders"
            android:textColor="@color/amarillo_vikingo"
            android:textSize="15sp"
            android:textAppearance="@style/TextShadowStyle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="5dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/Shape_MaterialCard_Square"
                app:strokeColor="@color/amarillo_vikingo">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/guerrero1_raid"
                    android:scaleType="centerCrop"/>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/Shape_MaterialCard_Square"
                app:strokeColor="@color/amarillo_vikingo">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/guerrero2_raid"
                    android:scaleType="centerCrop"/>

            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/boton13"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginStart="140dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/micro"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:fontFamily="@font/cormorant_garamond"
                android:textStyle="bold"
                android:text="@string/shieldmadien"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="12sp"
                android:textAppearance="@style/TextShadowStyle"/>

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:fontFamily="@font/cormorant_garamond"
                android:textStyle="bold"
                android:text="@string/shieldmadien"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="12sp"
                android:textAppearance="@style/TextShadowStyle"/>

        </LinearLayout>

        <ImageView
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:scaleType="centerCrop"
            android:src="@drawable/linea_amarilla"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/cormorant_garamond"
            android:textStyle="bold"
            android:text="@string/objectives"
            android:textColor="@color/amarillo_vikingo"
            android:textSize="15sp"
            android:textAppearance="@style/TextShadowStyle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/hierba"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/cormorant_garamond"
                android:textStyle="bold"
                android:text="@string/loot_saxon_villages"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="15sp"
                android:textAppearance="@style/TextShadowStyle"/>

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/tick"
                android:layout_marginStart="190dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/inocente"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/cormorant_garamond"
                android:textStyle="bold"
                android:text="@string/capture_treasures"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="15sp"
                android:textAppearance="@style/TextShadowStyle"/>

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/tick"
                android:layout_marginStart="195dp"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join_raid"
            android:layout_width="250dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/boton_1200"
            android:fontFamily="@font/cormorant_garamond"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="17dp"
            android:text="@string/join_raid"
            android:textColor="@color/amarillo_vikingo"
            android:textSize="20sp"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/guide_line_final2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.467"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/guide_line_boton_logout"
            app:layout_constraintVertical_bias="0.639"
            android:textAppearance="@style/TextShadowStyle"/>


    </LinearLayout>

    <ImageButton
        android:id="@+id/home"
        android:layout_width="75dp"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/icono_home"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cartera"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_chainStyle="spread_inside" />

    <ImageButton
        android:id="@+id/cartera"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="15dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/inicio"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/home"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintVertical_bias="0.521"
        app:srcCompat="@drawable/icono_cartera" />

    <ImageButton
        android:id="@+id/inicio"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="10dp"
        app:srcCompat="@drawable/icono_inicio"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/cartera"
        app:layout_constraintEnd_toStartOf="@+id/campana1"
        app:layout_constraintHorizontal_weight="1" />

    <ImageButton
        android:id="@+id/campana1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="30dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/icono_campana"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/inicio"
        app:layout_constraintEnd_toStartOf="@id/casco_guerrero"
        app:layout_constraintHorizontal_weight="1" />

    <ImageButton
        android:id="@+id/casco_guerrero"
        android:layout_width="70dp"
        android:layout_height="50dp"
        android:background="@android:color/transparent"
        android:layout_marginBottom="15dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/vikingo_perfil"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/campana1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.35" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_line_final2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.879617" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/margen_izquierdo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.06" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/margen_derecho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.94" />

</androidx.constraintlayout.widget.ConstraintLayout>