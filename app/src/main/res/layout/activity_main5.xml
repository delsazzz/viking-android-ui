        app:layout_constraintBottom_toTopOf="@+id/guide_line_boton_pago"
        app:layout_constraintEnd_toStartOf="@+id/margen_derecho"
        app:layout_constraintStart_toStartOf="@+id/margen_izquierdo"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
