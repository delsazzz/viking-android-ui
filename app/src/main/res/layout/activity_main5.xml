        app:iconGravity="textStart"
        app:iconPadding="15dp"
        app:iconTint="@color/amarillo_vikingo"
        app:layout_constraintEnd_toStartOf="@+id/margen_derecho"
        app:layout_constraintHorizontal_bias="0.695"
        app:layout_constraintStart_toStartOf="@+id/margen_izquierdo"
        app:layout_constraintTop_toBottomOf="@+id/guide_line_boton_pago"
        android:textAppearance="@style/TextShadowStyle"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_android"
        android:layout_width="339dp"
        android:layout_height="57dp"
        android:background="@drawable/boton_comprar"
        android:fontFamily="@font/cormorant_garamond"
        android:textStyle="bold"
        android:gravity="start|center_vertical"
        android:text="@string/pay_with_pay"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:backgroundTint="@null"
        app:icon="@drawable/google_logo"
        app:iconGravity="textStart"
        app:iconPadding="15dp"
        app:iconTint="@color/amarillo_vikingo"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_final2"
        app:layout_constraintEnd_toStartOf="@+id/margen_derecho"
        app:layout_constraintHorizontal_bias="0.695"
        app:layout_constraintStart_toStartOf="@+id/margen_izquierdo"
        app:layout_constraintTop_toBottomOf="@+id/button_apple"
        app:layout_constraintVertical_bias="0.0"
        android:textAppearance="@style/TextShadowStyle"/>

