                    android:gravity="start"
                    android:layout_marginStart="10dp"
                    android:text="@string/erik_thorvaldsson"
                    android:textColor="@color/amarillo_vikingo"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextShadowStyle"/>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/visa"
                    android:layout_marginEnd="10dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cormorant_garamond"
                    android:gravity="start"
                    android:layout_gravity="center"
                    android:text="@string/visa"
                    android:textColor="@color/amarillo_vikingo"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    android:textAppearance="@style/TextShadowStyle"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/cinzel_medium"
                    android:gravity="center"
                    android:text="@string/_4567"
                    android:layout_gravity="center"
                    android:textColor="@color/amarillo_vikingo"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextShadowStyle"/>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/tarjeta_credito"
                    android:layout_marginEnd="10dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/calendario"
                        android:layout_marginStart="10dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/cinzel_medium"
                        android:gravity="start"
                        android:text="@string/_12_25"
                        android:textColor="@color/amarillo_vikingo"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextShadowStyle"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/pin"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/cinzel_medium"
                        android:gravity="start"
                        android:text="@string/_123"
                        android:textColor="@color/amarillo_vikingo"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextShadowStyle"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

