                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cormorant_garamond"
                android:gravity="start"
                android:text="@string/subtotal"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAppearance="@style/TextShadowStyle"/>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="1dp"
                android:layout_gravity="center|bottom"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:layout_marginEnd="30dp"
                android:scaleType="centerCrop"
                android:src="@drawable/linea_amarilla" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="end"
                android:layout_weight="1"
                android:text="@string/_1_200_g"
                android:layout_gravity="end"
                android:textColor="@color/dorado_moneda"
                android:textStyle="bold"
                android:fontFamily="@font/cinzel_bold"
                android:textAppearance="@style/TextShadowStyle"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cormorant_garamond"
                android:gravity="start"
                android:text="@string/shipping"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAppearance="@style/TextShadowStyle"/>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="1dp"
                android:layout_gravity="center|bottom"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:layout_marginEnd="30dp"
                android:scaleType="centerCrop"
                android:src="@drawable/linea_amarilla" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:gravity="end"
                android:layout_weight="1"
                android:text="@string/_50g"
                android:layout_gravity="end"
                android:textColor="@color/dorado_moneda"
                android:textStyle="bold"
                android:fontFamily="@font/cinzel_bold"
                android:textAppearance="@style/TextShadowStyle"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cormorant_garamond"
                android:gravity="start"
                android:text="@string/total"
                android:textColor="@color/amarillo_vikingo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAppearance="@style/TextShadowStyle"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:gravity="end"
                android:layout_weight="1"
                android:text="@string/_1_250g"
                android:layout_gravity="end"
                android:textColor="@color/dorado_moneda"
                android:textStyle="bold"
                android:fontFamily="@font/cinzel_bold"
                android:textAppearance="@style/TextShadowStyle"/>

        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/linea_amarilla" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/cardview_pago"
        app:layout_constraintEnd_toStartOf="@+id/margen_derecho"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/margen_izquierdo"
        app:layout_constraintTop_toTopOf="@+id/guide_line_payment_information"
        app:layout_constraintVertical_bias="0.065">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginStart="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/linea_amarilla" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cormorant_garamond"
            android:gravity="center"
            android:text="@string/payment_information"
            android:textColor="@color/amarillo_vikingo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAppearance="@style/TextShadowStyle"/>

        <ImageView
