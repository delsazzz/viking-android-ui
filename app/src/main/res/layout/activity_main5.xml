        android:layout_marginBottom="18dp"
        android:layout_marginStart="10dp"
        app:srcCompat="@drawable/icono_inicio"
        app:layout_constraintTop_toTopOf="@id/guide_line_final2"
        app:layout_constraintBottom_toBottomOf="parent"
