        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_payment_information"
        app:layout_constraintEnd_toStartOf="@+id/margen_derecho"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/margen_izquierdo"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
