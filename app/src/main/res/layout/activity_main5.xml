                android:layout_height="30dp"
                android:layout_marginStart="30dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/outline_arrow_left_alt_24"/>

            <TextView
                android:id="@+id/viking_sword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"
                android:textSize="25sp"
                android:text="@string/checkout"
                android:layout_gravity="center"
                android:textColor="@color/amarillo_vikingo"
                android:textStyle="bold"
                android:fontFamily="@font/cormorant_garamond"
                android:textAppearance="@style/TextShadowStyle"/>

            <ImageView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:src="@drawable/moneda" />

            <TextView
                android:id="@+id/moneda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_gravity="center"
                android:layout_marginEnd="10dp"
                android:text="@string/_1_200_g"
                android:textSize="20sp"
                android:textColor="@color/dorado_moneda"
                android:textStyle="bold"
                android:fontFamily="@font/cinzel_bold"
                android:textAppearance="@style/TextShadowStyle"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cornerRadius="0dp"
        app:cardElevation="4dp"
        android:layout_margin="8dp"
        app:shapeAppearanceOverlay="@style/Shape_MaterialCard_Square"
        app:strokeWidth="2dp"
        app:strokeColor="@color/amarillo_vikingo"
        app:layout_constraintBottom_toTopOf="@+id/guide_line_order_sumary"
        app:layout_constraintEnd_toStartOf="@+id/margen_derecho"
        app:layout_constraintStart_toStartOf="@+id/margen_izquierdo"
        app:layout_constraintTop_toTopOf="@+id/guide_line_perfil">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

